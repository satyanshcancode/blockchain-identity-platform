REACT_APP_API_URL=http://localhost:4000
# Expected chain ID for the "wrong network" warning in WalletConnect (31337
# is Hardhat's default local chain ID).
REACT_APP_CHAIN_ID=31337
# Normally written automatically by scripts/loadAddresses.js from the shared
# deploy volume (see docker-compose.yml) - only set these by hand for local,
# non-Docker dev against a manually deployed set of contracts.
REACT_APP_ROLE_REGISTRY_ADDRESS=
REACT_APP_IDENTITY_REGISTRY_ADDRESS=
REACT_APP_ASSET_NFT_ADDRESS=
