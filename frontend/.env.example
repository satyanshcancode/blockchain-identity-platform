# Where the browser sends API reads, and the origin baked into asset QR codes.
# Both are optional: when unset, frontend/src/config/origins.js derives them
# from whatever host the page was actually loaded from - so opening the app at
# http://192.168.1.50:3000 makes both follow to that address automatically.
# Set them explicitly for a reverse proxy, a domain name, or an API on a
# different host than the UI.
#
# Under Docker these are set for you from the single PUBLIC_HOST variable in
# the ROOT .env (see ../.env.example and docker-compose.yml) - prefer that.
REACT_APP_API_BASE_URL=
REACT_APP_PUBLIC_BASE_URL=
# Legacy name for REACT_APP_API_BASE_URL. Still honored, but the new name wins.
REACT_APP_API_URL=
# Expected chain ID for the "wrong network" warning in WalletConnect (31337
# is Hardhat's default local chain ID).
REACT_APP_CHAIN_ID=31337
# Normally written automatically by scripts/loadAddresses.js from the shared
# deploy volume (see docker-compose.yml) - only set these by hand for local,
# non-Docker dev against a manually deployed set of contracts.
REACT_APP_ROLE_REGISTRY_ADDRESS=
REACT_APP_APPROVAL_REGISTRY_ADDRESS=
REACT_APP_IDENTITY_REGISTRY_ADDRESS=
REACT_APP_ASSET_NFT_ADDRESS=
