PORT=4000
RPC_URL=http://127.0.0.1:8545
# CORS is split by route group - see src/config/cors.js.
#
# The PUBLIC verification routes (/health, /api/assets/*,
# GET /api/identity/:address) accept ANY origin and are read-only: they serve
# only already-public on-chain data to wallet-free visitors scanning an asset's
# QR code, who are by definition not on this machine. Nothing below affects them.
#
# The ROLE-GATED routes (/api/audit/*, /api/approvals/*,
# /api/identity/:address/compliance) stay on a strict allowlist, built from:
#   PUBLIC_HOST     - this machine's LAN address, so an operator running the
#                     console over the LAN isn't locked out of the admin panel.
#                     Under Docker this comes from the root .env (see
#                     ../.env.example); http://<PUBLIC_HOST>:<FRONTEND_PORT>.
#   FRONTEND_ORIGIN - a single extra origin to allow.
#   PRIVATE_ORIGINS - explicit comma-separated list; overrides both of the above.
# http://localhost:3000 and http://127.0.0.1:3000 are always allowed.
PUBLIC_HOST=localhost
FRONTEND_PORT=3000
FRONTEND_ORIGIN=
PRIVATE_ORIGINS=
# Where the indexer's SQLite (sql.js) event store lives (see src/db.js). On
# every startup the indexer reads the last-processed block recorded here and
# replays anything emitted since via queryFilter before it starts listening
# live, so events aren't lost across a restart. Point this at a path backed
# by a volume that survives container recreation, not just process restarts
# (locally it defaults to backend/data/events.db if unset).
EVENTS_DB_PATH=
# Needed for auditor/admin-gated reads (e.g. GET /api/assets/:tokenId/history).
# Must be a key holding AUDITOR_ROLE or ADMIN_ROLE on RoleRegistry. Locally this
# is the Hardhat default account #0 key — see docker-compose.yml. Never use a
# real/funded key here.
PRIVATE_KEY=
ROLE_REGISTRY_ADDRESS=
APPROVAL_REGISTRY_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
ASSET_NFT_ADDRESS=