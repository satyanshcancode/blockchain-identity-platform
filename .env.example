# Copy to .env in this directory (`cp .env.example .env`) before `docker compose up`.
# Docker Compose reads it automatically for the ${...} substitutions in
# docker-compose.yml.

# The address OTHER DEVICES use to reach this machine.
#
# This is the one knob for public/QR reachability. It feeds three things:
#   - the origin baked into every asset's verification QR code
#   - the API base URL the browser fetches from
#   - the CORS allowlist for the role-gated admin routes
#
# Leave it as localhost and everything still works ON this machine, but any QR
# code you generate will be unscannable from a phone: "localhost" resolves to
# the scanning phone itself. The Assets tab shows a warning when that's the
# case. For a demo, set it to this machine's LAN IP.
#
# Find your LAN IP:
#   Windows:  ipconfig                       (IPv4 Address, the Wi-Fi adapter)
#   macOS:    ipconfig getifaddr en0
#   Linux:    hostname -I | awk '{print $1}'
#
# The phone and this machine must be on the same network, and inbound traffic
# to ports 3000 and 4000 must not be firewalled.
PUBLIC_HOST=localhost
